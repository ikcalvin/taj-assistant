OPENAI_API_KEY=your_openai_api_key
PINECONE_API_KEY=your_pinecone_api_key
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_database_token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET_TOKEN=your_random_webhook_secret
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_API_BASE_URL=https://api.telegram.org
SEARCH_API_KEY=your_tavily_api_key
MASTRA_CLOUD_ACCESS_TOKEN=your_mastra_cloud_access_token
MASTRA_OBSERVABILITY_LOGS_ENABLED=false

# --- Langfuse Observability (optional) ---
# Set both keys to enable Langfuse tracing alongside the default exporter
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com  # Optional: defaults to Langfuse cloud

# --- Security ---
# API key to protect /chat/* endpoints. Generate with: openssl rand -hex 32
MASTRA_API_KEY=your_mastra_api_key

# Comma-separated list of allowed CORS origins (defaults to http://localhost:3000)
ALLOWED_ORIGINS=http://localhost:3000
